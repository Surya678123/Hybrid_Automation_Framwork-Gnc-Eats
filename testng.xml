<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="GncEats Automation Suite">

    <listeners>
        <!-- Ensure your ExtentReportManager listener captures the full run -->
        <listener class-name="utilities.ExtentReportManager" />
    </listeners>

    <test name="End-to-End Regression Tests">
        <parameter name="os" value="Windows" />
        <parameter name="browser" value="edge" />
        <classes>
            <class name="testCases.TC001_AccountRegistrationTest" />
            <class name="testCases.TC002_Logintest" />
            <class name="testCases.TC003_LoginDDT" />
            <class name="testCases.TC004_AddToCart" />
            <class name="testCases.TC005_CheckOut" />
            <class name="testCases.TC006_Payment" />
        </classes>
    </test>
</suite>